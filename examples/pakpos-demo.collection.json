{
  "id": "pakpos-demo",
  "name": "PakPos Demo",
  "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
  "items": [
    {
      "kind": "folder",
      "id": "643638cd-fe0d-4603-ad57-6d5910ac93f8",
      "name": "Basics",
      "items": [
        {
          "kind": "request",
          "id": "f7e5fc9d-40af-404e-8453-ff879613526e",
          "name": "Get with query params",
          "method": "GET",
          "url": "{{base_url}}/get",
          "params": [
            {
              "key": "lang",
              "value": "id",
              "enabled": true
            },
            {
              "key": "app",
              "value": "pakpos",
              "enabled": true
            }
          ],
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "enabled": true
            }
          ],
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.args.lang",
              "op": "equals",
              "expected": "id"
            },
            {
              "enabled": true,
              "target": "time",
              "op": "less_than",
              "expected": "3000"
            }
          ],
          "description": "Sends query parameters and checks they are echoed back."
        },
        {
          "kind": "request",
          "id": "6b5f8f95-f159-49a2-9532-6418a69b3a66",
          "name": "Create user (JSON)",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "raw",
            "content": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.json.city",
              "op": "equals",
              "expected": "Jakarta"
            },
            {
              "enabled": true,
              "target": "header.Content-Type",
              "op": "contains",
              "expected": "json"
            }
          ],
          "examples": [
            {
              "id": "dabf3c65-70c2-42a8-9058-614a54c82972",
              "name": "Created",
              "status": 201,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"id\": \"usr_1001\",\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\"\n}"
            },
            {
              "id": "8e6da723-5209-43ec-a797-b72e82bf50f1",
              "name": "Validation error",
              "status": 422,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"error\": \"name is required\"\n}"
            }
          ]
        },
        {
          "kind": "request",
          "id": "7404f014-04ba-4ce3-a743-dfbd7960b65d",
          "name": "Submit form",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "form_url_encoded",
            "fields": [
              {
                "key": "username",
                "value": "budi",
                "enabled": true
              },
              {
                "key": "remember",
                "value": "true",
                "enabled": true
              }
            ]
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.form.username",
              "op": "equals",
              "expected": "budi"
            }
          ]
        },
        {
          "kind": "request",
          "id": "498ad6ba-2062-4d64-a7d2-e30cd7e8c0f5",
          "name": "Update user",
          "method": "PUT",
          "url": "{{base_url}}/put",
          "body": {
            "mode": "raw",
            "content": "{ \"city\": \"Bandung\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "75a9ab03-7237-4cda-8163-9740ecb9d9d3",
          "name": "Patch user",
          "method": "PATCH",
          "url": "{{base_url}}/patch",
          "body": {
            "mode": "raw",
            "content": "{ \"active\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "af767996-dedc-471d-92cc-d3f824840900",
          "name": "Delete user",
          "method": "DELETE",
          "url": "{{base_url}}/delete",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "a6e01934-9093-4b8b-9cde-6318d03da808",
          "name": "Set a cookie",
          "method": "GET",
          "url": "{{base_url}}/cookies/set?flavour=kopi-susu",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.cookies.flavour",
              "op": "equals",
              "expected": "kopi-susu"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "a41a2aed-f263-45d6-8a08-b0c7b14d1115",
      "name": "Auth",
      "items": [
        {
          "kind": "request",
          "id": "a599404f-5638-47c2-82dc-e488f9816f04",
          "name": "Bearer token",
          "method": "GET",
          "url": "{{base_url}}/bearer",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "36e0e8fc-02f8-4159-9edd-1d4fd89f716a",
          "name": "Basic auth",
          "method": "GET",
          "url": "{{base_url}}/basic-auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "basic",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "df9e01b6-0d46-475e-ad0c-cf0bc05d9572",
          "name": "Digest auth",
          "method": "GET",
          "url": "{{base_url}}/digest-auth/auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "digest",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "f4f74f6d-3591-41fe-8170-407f8863deeb",
          "name": "Profile (OAuth 2.0)",
          "method": "GET",
          "url": "{{base_url}}/oauth/me",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "oauth2",
            "grant": "client_credentials",
            "token_url": "{{base_url}}/oauth/token",
            "auth_url": "{{base_url}}/oauth/authorize",
            "client_id": "pakpos-demo",
            "client_secret": "demo-secret",
            "scope": "read",
            "redirect_uri": "http://127.0.0.1:7777/callback",
            "use_pkce": true,
            "client_auth": "header",
            "header_prefix": "Bearer"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.user",
              "op": "equals",
              "expected": "budi"
            }
          ],
          "description": "The token is fetched automatically (client credentials). Switch the grant to Authorization code to try the browser login against the mock API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "dfbbcf1b-6065-49f7-9b91-6ba29ab955b3",
      "name": "GraphQL",
      "items": [
        {
          "kind": "request",
          "id": "e872e845-fa1d-4a04-82d1-12fbb10e4ee7",
          "name": "Users by city (GraphQL)",
          "method": "POST",
          "url": "{{base_url}}/graphql",
          "body": {
            "mode": "graphql",
            "query": "query Users($city: String) {\n  users(city: $city) {\n    id\n    name\n    city\n  }\n}\n",
            "variables": "{ \"city\": \"Jakarta\" }"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.errors",
              "op": "not_exists",
              "expected": ""
            },
            {
              "enabled": true,
              "target": "json.data.users[0].city",
              "op": "equals",
              "expected": "Jakarta"
            }
          ],
          "description": "Click “Fetch schema” in the Body tab to browse the API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "b0ef16d2-d2d8-4b2e-89ea-71bd6d85b764",
      "name": "Realtime",
      "items": [
        {
          "kind": "request",
          "id": "68b39dfc-a2e7-4551-be29-5acd5d193352",
          "name": "Live prices (WebSocket)",
          "protocol": "websocket",
          "method": "GET",
          "url": "{{ws_url}}/ws",
          "body": {
            "mode": "raw",
            "content": "{\n  \"type\": \"subscribe\",\n  \"symbol\": \"IDR\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "description": "Works with the offline mock API (`python3 scripts/mock_httpbin.py`, environment “Local mock”): connect, then send the message from the Message tab. The server echoes it and pushes a tick every 2 seconds."
        },
        {
          "kind": "request",
          "id": "3c834a8a-5c2d-479f-8fdb-ed479a382a5a",
          "name": "Price stream (SSE)",
          "protocol": "sse",
          "method": "GET",
          "url": "{{base_url}}/sse",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "96cc9e94-b370-4e63-ad26-c9078399f0a8",
          "name": "Parcel events (Socket.IO)",
          "protocol": "socketio",
          "method": "GET",
          "url": "{{base_url}}",
          "body": {
            "mode": "raw",
            "content": "{ \"resi\": \"PP-2026-0042\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "realtime": {
            "event": "track",
            "qos": 0,
            "retain": false,
            "keep_alive_secs": 60,
            "clean_session": true
          }
        },
        {
          "kind": "request",
          "id": "aeab7297-7dda-49e5-b0db-95a7b39d12d1",
          "name": "Office sensors (MQTT)",
          "protocol": "mqtt",
          "method": "GET",
          "url": "{{mqtt_url}}",
          "body": {
            "mode": "raw",
            "content": "{ \"on\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "realtime": {
            "subscriptions": [
              {
                "enabled": true,
                "topic": "kantor/#",
                "qos": 1
              }
            ],
            "topic": "kantor/1/lampu",
            "qos": 0,
            "retain": false,
            "keep_alive_secs": 60,
            "clean_session": true
          },
          "description": "Start the demo broker with `python3 scripts/mock_mqtt.py`, then Connect."
        },
        {
          "kind": "request",
          "id": "35f2919d-9075-4b83-9955-f973836e0d6c",
          "name": "Health check (gRPC)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"service\": \"pakpos.demo\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "0"
            },
            {
              "enabled": true,
              "target": "json.status",
              "op": "exists",
              "expected": ""
            }
          ],
          "grpc": {
            "method": "grpc.health.v1.Health/Check"
          },
          "description": "Start the demo server with `cargo run -p pakpos-core --example grpc_demo_server`, then Load methods (server reflection) and Send."
        },
        {
          "kind": "request",
          "id": "060cb24e-9947-458c-9a25-af54959ae150",
          "name": "Chat (gRPC stream)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"user\": \"budi\",\n  \"text\": \"paket saya sudah sampai mana?\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "grpc": {
            "method": "pakpos.demo.Chat/Talk"
          },
          "description": "A bidirectional stream: Open stream, then Send message as often as you like; End stream when done."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "33cab344-2b77-47be-8136-881e95843a90",
      "name": "Responses",
      "items": [
        {
          "kind": "request",
          "id": "2c363295-1d9a-44e6-b0a1-f4710f46e7c2",
          "name": "Get UUID (extract)",
          "method": "GET",
          "url": "{{base_url}}/uuid",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.uuid",
              "op": "exists",
              "expected": ""
            }
          ],
          "extractions": [
            {
              "enabled": true,
              "variable": "last_uuid",
              "source": "json.uuid"
            }
          ],
          "examples": [
            {
              "id": "8782fa8d-d0a7-40ee-8273-12c58bf11e4e",
              "name": "Random UUID",
              "status": 200,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{ \"uuid\": \"0f8e6a7c-2b1d-4c3e-9f5a-8d7b6c5e4f3a\" }"
            }
          ]
        },
        {
          "kind": "request",
          "id": "595a3b5d-7b66-4bb9-8a34-21112c968110",
          "name": "JSON document",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.slideshow.author",
              "op": "exists",
              "expected": ""
            }
          ]
        },
        {
          "kind": "request",
          "id": "943e421d-4359-44b4-8530-a13cd82a3c86",
          "name": "Expect 404",
          "method": "GET",
          "url": "{{base_url}}/status/404",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "404"
            }
          ]
        },
        {
          "kind": "request",
          "id": "1afdb0ba-3606-4961-8268-3c61d3eb1fea",
          "name": "Scripted checks (JavaScript)",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "scripts": {
            "pre_request": "// Runs before sending: add a trace header.\npm.request.headers.upsert({ key: \"X-Trace-Id\", value: pm.variables.replaceIn(\"{{$guid}}\") });\n",
            "test": "pm.test(\"Status code is 200\", () => {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"Slideshow has slides\", () => {\n  const json = pm.response.json();\n  pm.expect(json.slideshow.slides).to.be.an(\"array\").that.is.not.empty;\n  pm.expect(json.slideshow.author).to.eql(\"PakPos\");\n});\n\npm.environment.set(\"slide_count\", pm.response.json().slideshow.slides.length);\nconsole.log(\"slides:\", pm.environment.get(\"slide_count\"));\n"
          },
          "description": "Postman-style pm.* scripts, run in a sandbox. Collections you import must be trusted before their scripts run."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    }
  ],
  "auth": {
    "type": "none"
  }
}
