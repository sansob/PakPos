{
  "id": "pakpos-demo",
  "name": "PakPos Demo",
  "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
  "items": [
    {
      "kind": "folder",
      "id": "962b4485-aed7-4f58-8a28-cb8be8e9712d",
      "name": "Basics",
      "items": [
        {
          "kind": "request",
          "id": "24094c44-eafb-4bcc-a533-639c4367e6ff",
          "name": "Get with query params",
          "method": "GET",
          "url": "{{base_url}}/get",
          "params": [
            {
              "key": "lang",
              "value": "id",
              "enabled": true
            },
            {
              "key": "app",
              "value": "pakpos",
              "enabled": true
            }
          ],
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "enabled": true
            }
          ],
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.args.lang",
              "op": "equals",
              "expected": "id"
            },
            {
              "enabled": true,
              "target": "time",
              "op": "less_than",
              "expected": "3000"
            }
          ],
          "description": "Sends query parameters and checks they are echoed back."
        },
        {
          "kind": "request",
          "id": "fe4552b4-3b3c-405e-9b01-ae00698cdf41",
          "name": "Create user (JSON)",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "raw",
            "content": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.json.city",
              "op": "equals",
              "expected": "Jakarta"
            },
            {
              "enabled": true,
              "target": "header.Content-Type",
              "op": "contains",
              "expected": "json"
            }
          ],
          "examples": [
            {
              "id": "b5ec597a-3f9c-4f6c-9a83-73ac5431cec1",
              "name": "Created",
              "status": 201,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"id\": \"usr_1001\",\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\"\n}"
            },
            {
              "id": "4438f3f5-9d34-4790-bfae-8f975b899923",
              "name": "Validation error",
              "status": 422,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"error\": \"name is required\"\n}"
            }
          ]
        },
        {
          "kind": "request",
          "id": "33a5db45-fc40-4165-a7a7-920e6670958f",
          "name": "Submit form",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "form_url_encoded",
            "fields": [
              {
                "key": "username",
                "value": "budi",
                "enabled": true
              },
              {
                "key": "remember",
                "value": "true",
                "enabled": true
              }
            ]
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.form.username",
              "op": "equals",
              "expected": "budi"
            }
          ]
        },
        {
          "kind": "request",
          "id": "e21d7992-566d-4cee-8151-0a8f4f64ab42",
          "name": "Update user",
          "method": "PUT",
          "url": "{{base_url}}/put",
          "body": {
            "mode": "raw",
            "content": "{ \"city\": \"Bandung\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "8bdd87fb-a187-4620-b8da-bc710c279174",
          "name": "Patch user",
          "method": "PATCH",
          "url": "{{base_url}}/patch",
          "body": {
            "mode": "raw",
            "content": "{ \"active\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "eb994560-7fec-4069-be9a-3d7376a13665",
          "name": "Delete user",
          "method": "DELETE",
          "url": "{{base_url}}/delete",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "d7019b14-db7a-4449-a7db-bb8efa6c700e",
          "name": "Set a cookie",
          "method": "GET",
          "url": "{{base_url}}/cookies/set?flavour=kopi-susu",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.cookies.flavour",
              "op": "equals",
              "expected": "kopi-susu"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "d7d773b1-8099-4fdb-ba01-1066e4a6dd96",
      "name": "Auth",
      "items": [
        {
          "kind": "request",
          "id": "9721c028-b231-4cb7-a8b6-2b502b03ba8e",
          "name": "Bearer token",
          "method": "GET",
          "url": "{{base_url}}/bearer",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "0943539d-191f-4f50-aa9e-445f2cf50aa1",
          "name": "Basic auth",
          "method": "GET",
          "url": "{{base_url}}/basic-auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "basic",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "ba14ddba-7a73-4f1f-bfcf-f87531ce8871",
          "name": "Digest auth",
          "method": "GET",
          "url": "{{base_url}}/digest-auth/auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "digest",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "f24c96b2-2239-4044-b53f-a935ab3caf46",
          "name": "Profile (OAuth 2.0)",
          "method": "GET",
          "url": "{{base_url}}/oauth/me",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "oauth2",
            "grant": "client_credentials",
            "token_url": "{{base_url}}/oauth/token",
            "auth_url": "{{base_url}}/oauth/authorize",
            "client_id": "pakpos-demo",
            "client_secret": "demo-secret",
            "scope": "read",
            "redirect_uri": "http://127.0.0.1:7777/callback",
            "use_pkce": true,
            "client_auth": "header",
            "header_prefix": "Bearer"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.user",
              "op": "equals",
              "expected": "budi"
            }
          ],
          "description": "The token is fetched automatically (client credentials). Switch the grant to Authorization code to try the browser login against the mock API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "acaa9d4d-5201-410f-bd59-2f6e8b1152d2",
      "name": "GraphQL",
      "items": [
        {
          "kind": "request",
          "id": "e11764bf-95ee-4dce-9dcc-66f626f46d50",
          "name": "Users by city (GraphQL)",
          "method": "POST",
          "url": "{{base_url}}/graphql",
          "body": {
            "mode": "graphql",
            "query": "query Users($city: String) {\n  users(city: $city) {\n    id\n    name\n    city\n  }\n}\n",
            "variables": "{ \"city\": \"Jakarta\" }"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.errors",
              "op": "not_exists",
              "expected": ""
            },
            {
              "enabled": true,
              "target": "json.data.users[0].city",
              "op": "equals",
              "expected": "Jakarta"
            }
          ],
          "description": "Click “Fetch schema” in the Body tab to browse the API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "64da91b1-beeb-40e8-9af1-3270a3bc05dc",
      "name": "Realtime",
      "items": [
        {
          "kind": "request",
          "id": "91489df0-049a-4cde-8ab2-9205af2ac450",
          "name": "Live prices (WebSocket)",
          "protocol": "websocket",
          "method": "GET",
          "url": "{{ws_url}}/ws",
          "body": {
            "mode": "raw",
            "content": "{\n  \"type\": \"subscribe\",\n  \"symbol\": \"IDR\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "description": "Works with the offline mock API (`python3 scripts/mock_httpbin.py`, environment “Local mock”): connect, then send the message from the Message tab. The server echoes it and pushes a tick every 2 seconds."
        },
        {
          "kind": "request",
          "id": "50af47a9-f361-45c0-9d08-5cf7fec7eab2",
          "name": "Health check (gRPC)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"service\": \"pakpos.demo\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "0"
            },
            {
              "enabled": true,
              "target": "json.status",
              "op": "exists",
              "expected": ""
            }
          ],
          "grpc": {
            "method": "grpc.health.v1.Health/Check"
          },
          "description": "Start the demo server with `cargo run -p pakpos-core --example grpc_demo_server`, then Load methods (server reflection) and Send."
        },
        {
          "kind": "request",
          "id": "64100a9a-6105-47e0-80bb-f25769712a8e",
          "name": "Chat (gRPC stream)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"user\": \"budi\",\n  \"text\": \"paket saya sudah sampai mana?\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "grpc": {
            "method": "pakpos.demo.Chat/Talk"
          },
          "description": "A bidirectional stream: Open stream, then Send message as often as you like; End stream when done."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "ccc6adb6-e2e9-4633-959b-0a7ce1417c0b",
      "name": "Responses",
      "items": [
        {
          "kind": "request",
          "id": "00006b87-1661-4eaa-92a2-740065b38c6b",
          "name": "Get UUID (extract)",
          "method": "GET",
          "url": "{{base_url}}/uuid",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.uuid",
              "op": "exists",
              "expected": ""
            }
          ],
          "extractions": [
            {
              "enabled": true,
              "variable": "last_uuid",
              "source": "json.uuid"
            }
          ],
          "examples": [
            {
              "id": "57c1b3d1-6bdb-49a5-9acb-8e82b88a8b33",
              "name": "Random UUID",
              "status": 200,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{ \"uuid\": \"0f8e6a7c-2b1d-4c3e-9f5a-8d7b6c5e4f3a\" }"
            }
          ]
        },
        {
          "kind": "request",
          "id": "d29c1ca1-5575-4421-b5ab-c927fcf34da5",
          "name": "JSON document",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.slideshow.author",
              "op": "exists",
              "expected": ""
            }
          ]
        },
        {
          "kind": "request",
          "id": "76cb95c9-70bd-4d0a-be31-84b5128e75a2",
          "name": "Expect 404",
          "method": "GET",
          "url": "{{base_url}}/status/404",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "404"
            }
          ]
        },
        {
          "kind": "request",
          "id": "91442547-ffbd-4200-802c-1cca80cb66db",
          "name": "Scripted checks (JavaScript)",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "scripts": {
            "pre_request": "// Runs before sending: add a trace header.\npm.request.headers.upsert({ key: \"X-Trace-Id\", value: pm.variables.replaceIn(\"{{$guid}}\") });\n",
            "test": "pm.test(\"Status code is 200\", () => {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"Slideshow has slides\", () => {\n  const json = pm.response.json();\n  pm.expect(json.slideshow.slides).to.be.an(\"array\").that.is.not.empty;\n  pm.expect(json.slideshow.author).to.eql(\"PakPos\");\n});\n\npm.environment.set(\"slide_count\", pm.response.json().slideshow.slides.length);\nconsole.log(\"slides:\", pm.environment.get(\"slide_count\"));\n"
          },
          "description": "Postman-style pm.* scripts, run in a sandbox. Collections you import must be trusted before their scripts run."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    }
  ],
  "auth": {
    "type": "none"
  }
}
