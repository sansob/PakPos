{
  "id": "pakpos-demo",
  "name": "PakPos Demo",
  "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
  "items": [
    {
      "kind": "folder",
      "id": "61cacb9b-2c46-4cd0-8567-3109c292d776",
      "name": "Basics",
      "items": [
        {
          "kind": "request",
          "id": "04c3cf97-2765-415c-92ed-c85a7df76517",
          "name": "Get with query params",
          "method": "GET",
          "url": "{{base_url}}/get",
          "params": [
            {
              "key": "lang",
              "value": "id",
              "enabled": true
            },
            {
              "key": "app",
              "value": "pakpos",
              "enabled": true
            }
          ],
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "enabled": true
            }
          ],
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.args.lang",
              "op": "equals",
              "expected": "id"
            },
            {
              "enabled": true,
              "target": "time",
              "op": "less_than",
              "expected": "3000"
            }
          ],
          "description": "Sends query parameters and checks they are echoed back."
        },
        {
          "kind": "request",
          "id": "2e7ddce0-5d5e-4b18-b99c-1498c832d8f2",
          "name": "Create user (JSON)",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "raw",
            "content": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.json.city",
              "op": "equals",
              "expected": "Jakarta"
            },
            {
              "enabled": true,
              "target": "header.Content-Type",
              "op": "contains",
              "expected": "json"
            }
          ],
          "examples": [
            {
              "id": "98b1fac0-2032-4df1-ab19-ca4653347837",
              "name": "Created",
              "status": 201,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"id\": \"usr_1001\",\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\"\n}"
            },
            {
              "id": "31740d18-e260-41ad-b773-4ba7dc481c0d",
              "name": "Validation error",
              "status": 422,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"error\": \"name is required\"\n}"
            }
          ]
        },
        {
          "kind": "request",
          "id": "63f06ea6-0f5a-40f8-8c5e-967bb2a57c1a",
          "name": "Submit form",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "form_url_encoded",
            "fields": [
              {
                "key": "username",
                "value": "budi",
                "enabled": true
              },
              {
                "key": "remember",
                "value": "true",
                "enabled": true
              }
            ]
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.form.username",
              "op": "equals",
              "expected": "budi"
            }
          ]
        },
        {
          "kind": "request",
          "id": "7092daaa-93ec-4e63-8a15-3550382c2406",
          "name": "Update user",
          "method": "PUT",
          "url": "{{base_url}}/put",
          "body": {
            "mode": "raw",
            "content": "{ \"city\": \"Bandung\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "53b092ce-08bc-467f-b5b9-164dc04a1943",
          "name": "Patch user",
          "method": "PATCH",
          "url": "{{base_url}}/patch",
          "body": {
            "mode": "raw",
            "content": "{ \"active\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "75105b80-c041-4f45-ba00-79cdc38739f9",
          "name": "Delete user",
          "method": "DELETE",
          "url": "{{base_url}}/delete",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "d8e80f9c-3f36-4997-9e3f-9638f5042a28",
          "name": "Set a cookie",
          "method": "GET",
          "url": "{{base_url}}/cookies/set?flavour=kopi-susu",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.cookies.flavour",
              "op": "equals",
              "expected": "kopi-susu"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "53d83235-3dbd-4cda-9ff8-7650b2699d8c",
      "name": "Auth",
      "items": [
        {
          "kind": "request",
          "id": "51c4e13e-2bdd-4bfb-88de-c6ddda9c68b0",
          "name": "Bearer token",
          "method": "GET",
          "url": "{{base_url}}/bearer",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "32b693db-7df2-4139-be3c-7cb40aad3bd3",
          "name": "Basic auth",
          "method": "GET",
          "url": "{{base_url}}/basic-auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "basic",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "1fa50b14-4312-4ad9-b5ae-0b33b86b4bce",
          "name": "Digest auth",
          "method": "GET",
          "url": "{{base_url}}/digest-auth/auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "digest",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "bebfb199-fc7b-4109-966f-2008574874cc",
          "name": "Profile (OAuth 2.0)",
          "method": "GET",
          "url": "{{base_url}}/oauth/me",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "oauth2",
            "grant": "client_credentials",
            "token_url": "{{base_url}}/oauth/token",
            "auth_url": "{{base_url}}/oauth/authorize",
            "client_id": "pakpos-demo",
            "client_secret": "demo-secret",
            "scope": "read",
            "redirect_uri": "http://127.0.0.1:7777/callback",
            "use_pkce": true,
            "client_auth": "header",
            "header_prefix": "Bearer"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.user",
              "op": "equals",
              "expected": "budi"
            }
          ],
          "description": "The token is fetched automatically (client credentials). Switch the grant to Authorization code to try the browser login against the mock API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "11c7566e-9fca-4604-8714-14526ee1ef89",
      "name": "GraphQL",
      "items": [
        {
          "kind": "request",
          "id": "326bceda-5dda-4f0a-a3c5-9c91c333e675",
          "name": "Users by city (GraphQL)",
          "method": "POST",
          "url": "{{base_url}}/graphql",
          "body": {
            "mode": "graphql",
            "query": "query Users($city: String) {\n  users(city: $city) {\n    id\n    name\n    city\n  }\n}\n",
            "variables": "{ \"city\": \"Jakarta\" }"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.errors",
              "op": "not_exists",
              "expected": ""
            },
            {
              "enabled": true,
              "target": "json.data.users[0].city",
              "op": "equals",
              "expected": "Jakarta"
            }
          ],
          "description": "Click “Fetch schema” in the Body tab to browse the API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "e5f2dc10-4f2e-4dfc-a171-874b6faaed85",
      "name": "Realtime",
      "items": [
        {
          "kind": "request",
          "id": "d95487d6-c239-403c-9077-7d8a861e0196",
          "name": "Live prices (WebSocket)",
          "protocol": "websocket",
          "method": "GET",
          "url": "{{ws_url}}/ws",
          "body": {
            "mode": "raw",
            "content": "{\n  \"type\": \"subscribe\",\n  \"symbol\": \"IDR\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "description": "Works with the offline mock API (`python3 scripts/mock_httpbin.py`, environment “Local mock”): connect, then send the message from the Message tab. The server echoes it and pushes a tick every 2 seconds."
        },
        {
          "kind": "request",
          "id": "c467782d-0a27-4d6b-817c-256ddcc6b833",
          "name": "Price stream (SSE)",
          "protocol": "sse",
          "method": "GET",
          "url": "{{base_url}}/sse",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "97c3e535-fa6c-4b81-9158-906b9783de42",
          "name": "Parcel events (Socket.IO)",
          "protocol": "socketio",
          "method": "GET",
          "url": "{{base_url}}",
          "body": {
            "mode": "raw",
            "content": "{ \"resi\": \"PP-2026-0042\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "realtime": {
            "event": "track",
            "qos": 0,
            "retain": false,
            "keep_alive_secs": 60,
            "clean_session": true
          }
        },
        {
          "kind": "request",
          "id": "09aa2497-7037-4753-8c17-8bbd134451f1",
          "name": "Office sensors (MQTT)",
          "protocol": "mqtt",
          "method": "GET",
          "url": "{{mqtt_url}}",
          "body": {
            "mode": "raw",
            "content": "{ \"on\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "realtime": {
            "subscriptions": [
              {
                "enabled": true,
                "topic": "kantor/#",
                "qos": 1
              }
            ],
            "topic": "kantor/1/lampu",
            "qos": 0,
            "retain": false,
            "keep_alive_secs": 60,
            "clean_session": true
          },
          "description": "Start the demo broker with `python3 scripts/mock_mqtt.py`, then Connect."
        },
        {
          "kind": "request",
          "id": "400c2d10-10ca-4f5d-bd1a-68a8b75da638",
          "name": "Health check (gRPC)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"service\": \"pakpos.demo\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "0"
            },
            {
              "enabled": true,
              "target": "json.status",
              "op": "exists",
              "expected": ""
            }
          ],
          "grpc": {
            "method": "grpc.health.v1.Health/Check"
          },
          "description": "Start the demo server with `cargo run -p pakpos-core --example grpc_demo_server`, then Load methods (server reflection) and Send."
        },
        {
          "kind": "request",
          "id": "eaf75986-6389-43ac-8130-d93c4ab5bf72",
          "name": "Chat (gRPC stream)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"user\": \"budi\",\n  \"text\": \"paket saya sudah sampai mana?\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "grpc": {
            "method": "pakpos.demo.Chat/Talk"
          },
          "description": "A bidirectional stream: Open stream, then Send message as often as you like; End stream when done."
        },
        {
          "kind": "request",
          "id": "f9583685-77bf-42a7-a501-0cb5a8a18c5e",
          "name": "Weather tool (MCP)",
          "protocol": "mcp",
          "method": "POST",
          "url": "{{base_url}}/mcp",
          "body": {
            "mode": "raw",
            "content": "{\n  \"city\": \"Jakarta\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.structuredContent.celsius",
              "op": "exists",
              "expected": ""
            },
            {
              "enabled": true,
              "target": "json.content[0].text",
              "op": "contains",
              "expected": "Jakarta"
            }
          ],
          "mcp": {
            "operation": "call_tool",
            "target": "weather"
          },
          "description": "Calls the `weather` tool of an MCP server like any request; the result is the response, so tests work. Load lists the tools."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "33c5629d-f221-4898-b915-533feb1b2b40",
      "name": "Responses",
      "items": [
        {
          "kind": "request",
          "id": "7607b1a3-4d25-40c8-a8e4-3d529b7bbba7",
          "name": "Get UUID (extract)",
          "method": "GET",
          "url": "{{base_url}}/uuid",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.uuid",
              "op": "exists",
              "expected": ""
            }
          ],
          "extractions": [
            {
              "enabled": true,
              "variable": "last_uuid",
              "source": "json.uuid"
            }
          ],
          "examples": [
            {
              "id": "548b173a-34e3-48ba-9e9c-716ecf8ceaad",
              "name": "Random UUID",
              "status": 200,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{ \"uuid\": \"0f8e6a7c-2b1d-4c3e-9f5a-8d7b6c5e4f3a\" }"
            }
          ]
        },
        {
          "kind": "request",
          "id": "15f5fb40-9cef-4a70-9009-d8044d0a8d80",
          "name": "JSON document",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.slideshow.author",
              "op": "exists",
              "expected": ""
            }
          ]
        },
        {
          "kind": "request",
          "id": "adbf0d77-c40a-4a2b-8760-83245305f537",
          "name": "Expect 404",
          "method": "GET",
          "url": "{{base_url}}/status/404",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "404"
            }
          ]
        },
        {
          "kind": "request",
          "id": "2b74d2c1-5a07-420e-87b1-1e649b0605b8",
          "name": "Scripted checks (JavaScript)",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "scripts": {
            "pre_request": "// Runs before sending: add a trace header.\npm.request.headers.upsert({ key: \"X-Trace-Id\", value: pm.variables.replaceIn(\"{{$guid}}\") });\n",
            "test": "pm.test(\"Status code is 200\", () => {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"Slideshow has slides\", () => {\n  const json = pm.response.json();\n  pm.expect(json.slideshow.slides).to.be.an(\"array\").that.is.not.empty;\n  pm.expect(json.slideshow.author).to.eql(\"PakPos\");\n});\n\npm.environment.set(\"slide_count\", pm.response.json().slideshow.slides.length);\nconsole.log(\"slides:\", pm.environment.get(\"slide_count\"));\n"
          },
          "description": "Postman-style pm.* scripts, run in a sandbox. Collections you import must be trusted before their scripts run."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    }
  ],
  "auth": {
    "type": "none"
  }
}
