{
  "id": "pakpos-demo",
  "name": "PakPos Demo",
  "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
  "items": [
    {
      "kind": "folder",
      "id": "bd1db8c8-81ef-4974-a5f0-84153c4cc1d3",
      "name": "Basics",
      "items": [
        {
          "kind": "request",
          "id": "06ed4171-3a1f-4b78-8340-b8f757dba4ea",
          "name": "Get with query params",
          "method": "GET",
          "url": "{{base_url}}/get",
          "params": [
            {
              "key": "lang",
              "value": "id",
              "enabled": true
            },
            {
              "key": "app",
              "value": "pakpos",
              "enabled": true
            }
          ],
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "enabled": true
            }
          ],
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.args.lang",
              "op": "equals",
              "expected": "id"
            },
            {
              "enabled": true,
              "target": "time",
              "op": "less_than",
              "expected": "3000"
            }
          ],
          "description": "Sends query parameters and checks they are echoed back."
        },
        {
          "kind": "request",
          "id": "80fb11e8-5482-4844-98b0-e472d6ac1452",
          "name": "Create user (JSON)",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "raw",
            "content": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.json.city",
              "op": "equals",
              "expected": "Jakarta"
            },
            {
              "enabled": true,
              "target": "header.Content-Type",
              "op": "contains",
              "expected": "json"
            }
          ]
        },
        {
          "kind": "request",
          "id": "f42a8431-009b-4134-aae4-1b0eff2c1546",
          "name": "Submit form",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "form_url_encoded",
            "fields": [
              {
                "key": "username",
                "value": "budi",
                "enabled": true
              },
              {
                "key": "remember",
                "value": "true",
                "enabled": true
              }
            ]
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.form.username",
              "op": "equals",
              "expected": "budi"
            }
          ]
        },
        {
          "kind": "request",
          "id": "83931179-4762-4d6d-a161-f5a37c1ac85c",
          "name": "Update user",
          "method": "PUT",
          "url": "{{base_url}}/put",
          "body": {
            "mode": "raw",
            "content": "{ \"city\": \"Bandung\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "de131592-55ff-4bd4-b287-dc1a1ef95420",
          "name": "Patch user",
          "method": "PATCH",
          "url": "{{base_url}}/patch",
          "body": {
            "mode": "raw",
            "content": "{ \"active\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "dc9e0385-e5de-46a4-89a1-072c20433677",
          "name": "Delete user",
          "method": "DELETE",
          "url": "{{base_url}}/delete",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "74553db5-44c2-465a-b1a9-3a8175a3671f",
      "name": "Auth",
      "items": [
        {
          "kind": "request",
          "id": "c887ee12-fa05-468e-92cd-f7b28096359b",
          "name": "Bearer token",
          "method": "GET",
          "url": "{{base_url}}/bearer",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "948637ab-7d85-49e8-b64f-950d16ccd4ae",
          "name": "Basic auth",
          "method": "GET",
          "url": "{{base_url}}/basic-auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "basic",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "036a4242-1969-458e-a57f-542c324d671e",
          "name": "Profile (OAuth 2.0)",
          "method": "GET",
          "url": "{{base_url}}/oauth/me",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "oauth2",
            "grant": "client_credentials",
            "token_url": "{{base_url}}/oauth/token",
            "auth_url": "{{base_url}}/oauth/authorize",
            "client_id": "pakpos-demo",
            "client_secret": "demo-secret",
            "scope": "read",
            "redirect_uri": "http://127.0.0.1:7777/callback",
            "use_pkce": true,
            "client_auth": "header",
            "header_prefix": "Bearer"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.user",
              "op": "equals",
              "expected": "budi"
            }
          ],
          "description": "The token is fetched automatically (client credentials). Switch the grant to Authorization code to try the browser login against the mock API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "2dc63b43-a971-4810-9bb4-ef5389c3c461",
      "name": "GraphQL",
      "items": [
        {
          "kind": "request",
          "id": "e94f1d80-f6ba-489f-b4f5-245cb562d5c7",
          "name": "Users by city (GraphQL)",
          "method": "POST",
          "url": "{{base_url}}/graphql",
          "body": {
            "mode": "graphql",
            "query": "query Users($city: String) {\n  users(city: $city) {\n    id\n    name\n    city\n  }\n}\n",
            "variables": "{ \"city\": \"Jakarta\" }"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.errors",
              "op": "not_exists",
              "expected": ""
            },
            {
              "enabled": true,
              "target": "json.data.users[0].city",
              "op": "equals",
              "expected": "Jakarta"
            }
          ],
          "description": "Click “Fetch schema” in the Body tab to browse the API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "1687fd9e-a74c-416b-8048-6c120c01f0f3",
      "name": "Responses",
      "items": [
        {
          "kind": "request",
          "id": "0a4e945e-3c5f-4c2a-b715-4480c22408f8",
          "name": "Get UUID (extract)",
          "method": "GET",
          "url": "{{base_url}}/uuid",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.uuid",
              "op": "exists",
              "expected": ""
            }
          ],
          "extractions": [
            {
              "enabled": true,
              "variable": "last_uuid",
              "source": "json.uuid"
            }
          ]
        },
        {
          "kind": "request",
          "id": "af416f5e-e69a-4eb6-a63f-2cdae04e5da2",
          "name": "JSON document",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.slideshow.author",
              "op": "exists",
              "expected": ""
            }
          ]
        },
        {
          "kind": "request",
          "id": "2464e0ee-c643-457a-905a-ab9fe4da1c2b",
          "name": "Expect 404",
          "method": "GET",
          "url": "{{base_url}}/status/404",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "404"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    }
  ],
  "auth": {
    "type": "none"
  }
}
