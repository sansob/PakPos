{
  "id": "pakpos-demo",
  "name": "PakPos Demo",
  "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
  "items": [
    {
      "kind": "folder",
      "id": "e8807e2e-22f1-47fb-bc1f-b1c420437623",
      "name": "Basics",
      "items": [
        {
          "kind": "request",
          "id": "b49357c0-4a2a-495e-b2ac-3bb7cf601ada",
          "name": "Get with query params",
          "method": "GET",
          "url": "{{base_url}}/get",
          "params": [
            {
              "key": "lang",
              "value": "id",
              "enabled": true
            },
            {
              "key": "app",
              "value": "pakpos",
              "enabled": true
            }
          ],
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "enabled": true
            }
          ],
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.args.lang",
              "op": "equals",
              "expected": "id"
            },
            {
              "enabled": true,
              "target": "time",
              "op": "less_than",
              "expected": "3000"
            }
          ],
          "description": "Sends query parameters and checks they are echoed back."
        },
        {
          "kind": "request",
          "id": "00cfb6c3-f9ea-4e49-9546-d338383d69bd",
          "name": "Create user (JSON)",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "raw",
            "content": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.json.city",
              "op": "equals",
              "expected": "Jakarta"
            },
            {
              "enabled": true,
              "target": "header.Content-Type",
              "op": "contains",
              "expected": "json"
            }
          ],
          "examples": [
            {
              "id": "7c2e8f25-c9a0-4348-a42b-3838abf9f59b",
              "name": "Created",
              "status": 201,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"id\": \"usr_1001\",\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\"\n}"
            },
            {
              "id": "8ba45eb3-3358-473f-ab5e-22a2a0e17b81",
              "name": "Validation error",
              "status": 422,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"error\": \"name is required\"\n}"
            }
          ]
        },
        {
          "kind": "request",
          "id": "c6a9cdf8-d702-4393-a7cc-2ad6d532f028",
          "name": "Submit form",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "form_url_encoded",
            "fields": [
              {
                "key": "username",
                "value": "budi",
                "enabled": true
              },
              {
                "key": "remember",
                "value": "true",
                "enabled": true
              }
            ]
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.form.username",
              "op": "equals",
              "expected": "budi"
            }
          ]
        },
        {
          "kind": "request",
          "id": "452e8781-50e6-4a5f-90af-3fefa6e9050c",
          "name": "Update user",
          "method": "PUT",
          "url": "{{base_url}}/put",
          "body": {
            "mode": "raw",
            "content": "{ \"city\": \"Bandung\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "c8b2266c-5b0b-48bd-a3a8-4400e5c7d496",
          "name": "Patch user",
          "method": "PATCH",
          "url": "{{base_url}}/patch",
          "body": {
            "mode": "raw",
            "content": "{ \"active\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "757e89bf-8f5f-4f1c-8aee-bf67c7aa29e2",
          "name": "Delete user",
          "method": "DELETE",
          "url": "{{base_url}}/delete",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "81249e95-3313-4aad-a277-ee397a1ddea4",
      "name": "Auth",
      "items": [
        {
          "kind": "request",
          "id": "ecd0ae5a-7aff-4d3e-8b44-9eebdb0aa883",
          "name": "Bearer token",
          "method": "GET",
          "url": "{{base_url}}/bearer",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "b985594d-dd6b-4aa0-a2c9-caf9334f995f",
          "name": "Basic auth",
          "method": "GET",
          "url": "{{base_url}}/basic-auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "basic",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "f0ce23e9-82d4-4574-859f-a54099c38e0b",
          "name": "Digest auth",
          "method": "GET",
          "url": "{{base_url}}/digest-auth/auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "digest",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "a42339b4-a047-40bd-94ff-2270745ce6dc",
          "name": "Profile (OAuth 2.0)",
          "method": "GET",
          "url": "{{base_url}}/oauth/me",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "oauth2",
            "grant": "client_credentials",
            "token_url": "{{base_url}}/oauth/token",
            "auth_url": "{{base_url}}/oauth/authorize",
            "client_id": "pakpos-demo",
            "client_secret": "demo-secret",
            "scope": "read",
            "redirect_uri": "http://127.0.0.1:7777/callback",
            "use_pkce": true,
            "client_auth": "header",
            "header_prefix": "Bearer"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.user",
              "op": "equals",
              "expected": "budi"
            }
          ],
          "description": "The token is fetched automatically (client credentials). Switch the grant to Authorization code to try the browser login against the mock API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "f1cedf78-883a-4dc7-ac26-52296a7eaeb3",
      "name": "GraphQL",
      "items": [
        {
          "kind": "request",
          "id": "ebf43d74-d3b5-47cb-aade-a8d2af4f2ae0",
          "name": "Users by city (GraphQL)",
          "method": "POST",
          "url": "{{base_url}}/graphql",
          "body": {
            "mode": "graphql",
            "query": "query Users($city: String) {\n  users(city: $city) {\n    id\n    name\n    city\n  }\n}\n",
            "variables": "{ \"city\": \"Jakarta\" }"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.errors",
              "op": "not_exists",
              "expected": ""
            },
            {
              "enabled": true,
              "target": "json.data.users[0].city",
              "op": "equals",
              "expected": "Jakarta"
            }
          ],
          "description": "Click “Fetch schema” in the Body tab to browse the API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "1573eed2-e6d6-408d-b65d-d7f462819c6f",
      "name": "Realtime",
      "items": [
        {
          "kind": "request",
          "id": "01ca2d60-32a7-4fe7-a22f-29a9cb416a9c",
          "name": "Live prices (WebSocket)",
          "protocol": "websocket",
          "method": "GET",
          "url": "{{ws_url}}/ws",
          "body": {
            "mode": "raw",
            "content": "{\n  \"type\": \"subscribe\",\n  \"symbol\": \"IDR\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "description": "Works with the offline mock API (`python3 scripts/mock_httpbin.py`, environment “Local mock”): connect, then send the message from the Message tab. The server echoes it and pushes a tick every 2 seconds."
        },
        {
          "kind": "request",
          "id": "45f17d77-d9d6-40a2-87aa-6a6b747dcef0",
          "name": "Health check (gRPC)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"service\": \"pakpos.demo\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "0"
            },
            {
              "enabled": true,
              "target": "json.status",
              "op": "exists",
              "expected": ""
            }
          ],
          "grpc": {
            "method": "grpc.health.v1.Health/Check"
          },
          "description": "Start the demo server with `cargo run -p pakpos-core --example grpc_demo_server`, then Load methods (server reflection) and Send."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "53d731c2-2ef5-4be8-8cef-c459268d83e6",
      "name": "Responses",
      "items": [
        {
          "kind": "request",
          "id": "7d9bd419-117f-4c6d-8c05-5aad9d7be982",
          "name": "Get UUID (extract)",
          "method": "GET",
          "url": "{{base_url}}/uuid",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.uuid",
              "op": "exists",
              "expected": ""
            }
          ],
          "extractions": [
            {
              "enabled": true,
              "variable": "last_uuid",
              "source": "json.uuid"
            }
          ],
          "examples": [
            {
              "id": "16774e7c-c3f8-4909-9f67-d86f4d61e51a",
              "name": "Random UUID",
              "status": 200,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{ \"uuid\": \"0f8e6a7c-2b1d-4c3e-9f5a-8d7b6c5e4f3a\" }"
            }
          ]
        },
        {
          "kind": "request",
          "id": "e4c0266d-5401-4c7a-a6b7-1b3b60496c07",
          "name": "JSON document",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.slideshow.author",
              "op": "exists",
              "expected": ""
            }
          ]
        },
        {
          "kind": "request",
          "id": "67a57dba-941c-4f44-b643-c36674daf27c",
          "name": "Expect 404",
          "method": "GET",
          "url": "{{base_url}}/status/404",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "404"
            }
          ]
        },
        {
          "kind": "request",
          "id": "b0763a79-e75b-46b6-856a-5604fb7b1128",
          "name": "Scripted checks (JavaScript)",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "scripts": {
            "pre_request": "// Runs before sending: add a trace header.\npm.request.headers.upsert({ key: \"X-Trace-Id\", value: pm.variables.replaceIn(\"{{$guid}}\") });\n",
            "test": "pm.test(\"Status code is 200\", () => {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"Slideshow has slides\", () => {\n  const json = pm.response.json();\n  pm.expect(json.slideshow.slides).to.be.an(\"array\").that.is.not.empty;\n  pm.expect(json.slideshow.author).to.eql(\"PakPos\");\n});\n\npm.environment.set(\"slide_count\", pm.response.json().slideshow.slides.length);\nconsole.log(\"slides:\", pm.environment.get(\"slide_count\"));\n"
          },
          "description": "Postman-style pm.* scripts, run in a sandbox. Collections you import must be trusted before their scripts run."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    }
  ],
  "auth": {
    "type": "none"
  }
}
