{
  "id": "pakpos-demo",
  "name": "PakPos Demo",
  "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
  "items": [
    {
      "kind": "folder",
      "id": "45b0f477-8f5b-4813-b5a2-f654baf854e0",
      "name": "Basics",
      "items": [
        {
          "kind": "request",
          "id": "3dff918c-baf9-4403-bbac-52adbb097436",
          "name": "Get with query params",
          "method": "GET",
          "url": "{{base_url}}/get",
          "params": [
            {
              "key": "lang",
              "value": "id",
              "enabled": true
            },
            {
              "key": "app",
              "value": "pakpos",
              "enabled": true
            }
          ],
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "enabled": true
            }
          ],
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.args.lang",
              "op": "equals",
              "expected": "id"
            },
            {
              "enabled": true,
              "target": "time",
              "op": "less_than",
              "expected": "3000"
            }
          ],
          "description": "Sends query parameters and checks they are echoed back."
        },
        {
          "kind": "request",
          "id": "6ef2b8c6-c3c5-48f0-be6e-15e66568dece",
          "name": "Create user (JSON)",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "raw",
            "content": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.json.city",
              "op": "equals",
              "expected": "Jakarta"
            },
            {
              "enabled": true,
              "target": "header.Content-Type",
              "op": "contains",
              "expected": "json"
            }
          ]
        },
        {
          "kind": "request",
          "id": "7e239b7f-1f35-420b-906d-6da6d6a7b941",
          "name": "Submit form",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "form_url_encoded",
            "fields": [
              {
                "key": "username",
                "value": "budi",
                "enabled": true
              },
              {
                "key": "remember",
                "value": "true",
                "enabled": true
              }
            ]
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.form.username",
              "op": "equals",
              "expected": "budi"
            }
          ]
        },
        {
          "kind": "request",
          "id": "8b71c528-452b-4038-92ab-6598c0c15fa8",
          "name": "Update user",
          "method": "PUT",
          "url": "{{base_url}}/put",
          "body": {
            "mode": "raw",
            "content": "{ \"city\": \"Bandung\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "00650240-3089-4630-8ecd-8c21d197d4e1",
          "name": "Patch user",
          "method": "PATCH",
          "url": "{{base_url}}/patch",
          "body": {
            "mode": "raw",
            "content": "{ \"active\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "5e6bace2-698f-40e6-8631-1c0ff5e3cc7c",
          "name": "Delete user",
          "method": "DELETE",
          "url": "{{base_url}}/delete",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "b9cc6ac3-d366-47c5-ae95-cde2a91e15d4",
      "name": "Auth",
      "items": [
        {
          "kind": "request",
          "id": "84803d07-e873-4474-b816-b783d0da7487",
          "name": "Bearer token",
          "method": "GET",
          "url": "{{base_url}}/bearer",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "455dc89e-a898-4a5c-b323-2f043f08f74a",
          "name": "Basic auth",
          "method": "GET",
          "url": "{{base_url}}/basic-auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "basic",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "ab79eecc-5f8c-4818-8b46-5450a1b7bba5",
          "name": "Profile (OAuth 2.0)",
          "method": "GET",
          "url": "{{base_url}}/oauth/me",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "oauth2",
            "grant": "client_credentials",
            "token_url": "{{base_url}}/oauth/token",
            "auth_url": "{{base_url}}/oauth/authorize",
            "client_id": "pakpos-demo",
            "client_secret": "demo-secret",
            "scope": "read",
            "redirect_uri": "http://127.0.0.1:7777/callback",
            "use_pkce": true,
            "client_auth": "header",
            "header_prefix": "Bearer"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.user",
              "op": "equals",
              "expected": "budi"
            }
          ],
          "description": "The token is fetched automatically (client credentials). Switch the grant to Authorization code to try the browser login against the mock API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "805ea633-5389-4b71-9e6d-c762f2016b4c",
      "name": "Responses",
      "items": [
        {
          "kind": "request",
          "id": "a8d92a64-ae30-4972-bfa2-a61339e16eb9",
          "name": "Get UUID (extract)",
          "method": "GET",
          "url": "{{base_url}}/uuid",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.uuid",
              "op": "exists",
              "expected": ""
            }
          ],
          "extractions": [
            {
              "enabled": true,
              "variable": "last_uuid",
              "source": "json.uuid"
            }
          ]
        },
        {
          "kind": "request",
          "id": "b7535d87-3848-451f-a01b-19913c4d3b31",
          "name": "JSON document",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.slideshow.author",
              "op": "exists",
              "expected": ""
            }
          ]
        },
        {
          "kind": "request",
          "id": "a9caaad2-2c51-47d1-8463-12f34ad2d32a",
          "name": "Expect 404",
          "method": "GET",
          "url": "{{base_url}}/status/404",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "404"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    }
  ],
  "auth": {
    "type": "none"
  }
}
