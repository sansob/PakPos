{
  "id": "pakpos-demo",
  "name": "PakPos Demo",
  "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
  "items": [
    {
      "kind": "folder",
      "id": "41bf8957-07c7-4719-9225-97fb1aad21dc",
      "name": "Basics",
      "items": [
        {
          "kind": "request",
          "id": "cf8c367b-3f1e-4d0d-aff5-acfed8659e6c",
          "name": "Get with query params",
          "method": "GET",
          "url": "{{base_url}}/get",
          "params": [
            {
              "key": "lang",
              "value": "id",
              "enabled": true
            },
            {
              "key": "app",
              "value": "pakpos",
              "enabled": true
            }
          ],
          "headers": [
            {
              "key": "Accept",
              "value": "application/json",
              "enabled": true
            }
          ],
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.args.lang",
              "op": "equals",
              "expected": "id"
            },
            {
              "enabled": true,
              "target": "time",
              "op": "less_than",
              "expected": "3000"
            }
          ],
          "description": "Sends query parameters and checks they are echoed back."
        },
        {
          "kind": "request",
          "id": "b75725ca-3ec2-4a4f-88de-d40b14773c21",
          "name": "Create user (JSON)",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "raw",
            "content": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.json.city",
              "op": "equals",
              "expected": "Jakarta"
            },
            {
              "enabled": true,
              "target": "header.Content-Type",
              "op": "contains",
              "expected": "json"
            }
          ],
          "examples": [
            {
              "id": "c28df400-2047-4fbd-b248-6d13954623ac",
              "name": "Created",
              "status": 201,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"id\": \"usr_1001\",\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\"\n}"
            },
            {
              "id": "58739d53-a3a6-4331-9d58-2a80ac6a3ab8",
              "name": "Validation error",
              "status": 422,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{\n  \"error\": \"name is required\"\n}"
            }
          ]
        },
        {
          "kind": "request",
          "id": "4d869abb-0100-49ee-a116-f2f9920b5a72",
          "name": "Submit form",
          "method": "POST",
          "url": "{{base_url}}/post",
          "body": {
            "mode": "form_url_encoded",
            "fields": [
              {
                "key": "username",
                "value": "budi",
                "enabled": true
              },
              {
                "key": "remember",
                "value": "true",
                "enabled": true
              }
            ]
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.form.username",
              "op": "equals",
              "expected": "budi"
            }
          ]
        },
        {
          "kind": "request",
          "id": "6ffbad20-db12-404e-8d2c-16ab9c4e69cc",
          "name": "Update user",
          "method": "PUT",
          "url": "{{base_url}}/put",
          "body": {
            "mode": "raw",
            "content": "{ \"city\": \"Bandung\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "0ad54111-bc55-409c-9ced-dc7a046a9830",
          "name": "Patch user",
          "method": "PATCH",
          "url": "{{base_url}}/patch",
          "body": {
            "mode": "raw",
            "content": "{ \"active\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "9ed62306-9ea4-4ea8-b660-526e273e5c06",
          "name": "Delete user",
          "method": "DELETE",
          "url": "{{base_url}}/delete",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "f5dfb6ea-3cdb-4d59-ac55-2fd903a65dab",
          "name": "Set a cookie",
          "method": "GET",
          "url": "{{base_url}}/cookies/set?flavour=kopi-susu",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.cookies.flavour",
              "op": "equals",
              "expected": "kopi-susu"
            }
          ]
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "2a4148dd-5512-496d-af50-09b0e39c25df",
      "name": "Auth",
      "items": [
        {
          "kind": "request",
          "id": "647698eb-8753-459d-81e6-f089091e4672",
          "name": "Bearer token",
          "method": "GET",
          "url": "{{base_url}}/bearer",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "bcbafea9-f80c-4280-b778-547f2fb610a2",
          "name": "Basic auth",
          "method": "GET",
          "url": "{{base_url}}/basic-auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "basic",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            }
          ]
        },
        {
          "kind": "request",
          "id": "93c50cd7-ce23-4f21-a059-344d096ea0dc",
          "name": "Digest auth",
          "method": "GET",
          "url": "{{base_url}}/digest-auth/auth/pakpos/rahasia",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "digest",
            "username": "pakpos",
            "password": "rahasia"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.authenticated",
              "op": "equals",
              "expected": "true"
            }
          ]
        },
        {
          "kind": "request",
          "id": "b130ede4-2a89-4d44-90df-d91627d41dd0",
          "name": "Profile (OAuth 2.0)",
          "method": "GET",
          "url": "{{base_url}}/oauth/me",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "oauth2",
            "grant": "client_credentials",
            "token_url": "{{base_url}}/oauth/token",
            "auth_url": "{{base_url}}/oauth/authorize",
            "client_id": "pakpos-demo",
            "client_secret": "demo-secret",
            "scope": "read",
            "redirect_uri": "http://127.0.0.1:7777/callback",
            "use_pkce": true,
            "client_auth": "header",
            "header_prefix": "Bearer"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.user",
              "op": "equals",
              "expected": "budi"
            }
          ],
          "description": "The token is fetched automatically (client credentials). Switch the grant to Authorization code to try the browser login against the mock API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "eb27be03-7a6e-4af3-aa14-7cea1cd6c64e",
      "name": "GraphQL",
      "items": [
        {
          "kind": "request",
          "id": "711be939-f0a3-48ff-aa8e-bbb1c46164cd",
          "name": "Users by city (GraphQL)",
          "method": "POST",
          "url": "{{base_url}}/graphql",
          "body": {
            "mode": "graphql",
            "query": "query Users($city: String) {\n  users(city: $city) {\n    id\n    name\n    city\n  }\n}\n",
            "variables": "{ \"city\": \"Jakarta\" }"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.errors",
              "op": "not_exists",
              "expected": ""
            },
            {
              "enabled": true,
              "target": "json.data.users[0].city",
              "op": "equals",
              "expected": "Jakarta"
            }
          ],
          "description": "Click “Fetch schema” in the Body tab to browse the API."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "65b0151f-5c19-48ea-a75c-b3b8f265175e",
      "name": "Realtime",
      "items": [
        {
          "kind": "request",
          "id": "bf87c616-85bd-4586-8a64-515111b3e45d",
          "name": "Live prices (WebSocket)",
          "protocol": "websocket",
          "method": "GET",
          "url": "{{ws_url}}/ws",
          "body": {
            "mode": "raw",
            "content": "{\n  \"type\": \"subscribe\",\n  \"symbol\": \"IDR\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "bearer",
            "token": "{{token}}"
          },
          "description": "Works with the offline mock API (`python3 scripts/mock_httpbin.py`, environment “Local mock”): connect, then send the message from the Message tab. The server echoes it and pushes a tick every 2 seconds."
        },
        {
          "kind": "request",
          "id": "7d62be33-74af-4bc7-be6e-b63cec7e3845",
          "name": "Price stream (SSE)",
          "protocol": "sse",
          "method": "GET",
          "url": "{{base_url}}/sse",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          }
        },
        {
          "kind": "request",
          "id": "1a206acc-5c8f-4c98-8d96-811530fd044e",
          "name": "Parcel events (Socket.IO)",
          "protocol": "socketio",
          "method": "GET",
          "url": "{{base_url}}",
          "body": {
            "mode": "raw",
            "content": "{ \"resi\": \"PP-2026-0042\" }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "realtime": {
            "event": "track",
            "qos": 0,
            "retain": false,
            "keep_alive_secs": 60,
            "clean_session": true
          }
        },
        {
          "kind": "request",
          "id": "6899de40-5b82-4e1f-82f1-50338d439d6b",
          "name": "Office sensors (MQTT)",
          "protocol": "mqtt",
          "method": "GET",
          "url": "{{mqtt_url}}",
          "body": {
            "mode": "raw",
            "content": "{ \"on\": true }",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "realtime": {
            "subscriptions": [
              {
                "enabled": true,
                "topic": "kantor/#",
                "qos": 1
              }
            ],
            "topic": "kantor/1/lampu",
            "qos": 0,
            "retain": false,
            "keep_alive_secs": 60,
            "clean_session": true
          },
          "description": "Start the demo broker with `python3 scripts/mock_mqtt.py`, then Connect."
        },
        {
          "kind": "request",
          "id": "fb3b665d-248c-49ed-86ca-322d80406e1a",
          "name": "Health check (gRPC)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"service\": \"pakpos.demo\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "0"
            },
            {
              "enabled": true,
              "target": "json.status",
              "op": "exists",
              "expected": ""
            }
          ],
          "grpc": {
            "method": "grpc.health.v1.Health/Check"
          },
          "description": "Start the demo server with `cargo run -p pakpos-core --example grpc_demo_server`, then Load methods (server reflection) and Send."
        },
        {
          "kind": "request",
          "id": "a89fb2ce-230d-447b-bc03-40edce58bce5",
          "name": "Chat (gRPC stream)",
          "protocol": "grpc",
          "method": "POST",
          "url": "{{grpc_url}}",
          "body": {
            "mode": "raw",
            "content": "{\n  \"user\": \"budi\",\n  \"text\": \"paket saya sudah sampai mana?\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "grpc": {
            "method": "pakpos.demo.Chat/Talk"
          },
          "description": "A bidirectional stream: Open stream, then Send message as often as you like; End stream when done."
        },
        {
          "kind": "request",
          "id": "1f49eb35-537a-4e49-9a15-78af3c6bea6d",
          "name": "Weather tool (MCP)",
          "protocol": "mcp",
          "method": "POST",
          "url": "{{base_url}}/mcp",
          "body": {
            "mode": "raw",
            "content": "{\n  \"city\": \"Jakarta\"\n}",
            "language": "json"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "200"
            },
            {
              "enabled": true,
              "target": "json.structuredContent.celsius",
              "op": "exists",
              "expected": ""
            },
            {
              "enabled": true,
              "target": "json.content[0].text",
              "op": "contains",
              "expected": "Jakarta"
            }
          ],
          "mcp": {
            "operation": "call_tool",
            "target": "weather"
          },
          "description": "Calls the `weather` tool of an MCP server like any request; the result is the response, so tests work. Load lists the tools."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    },
    {
      "kind": "folder",
      "id": "724595ad-5209-47ab-9466-0bcaa2f6b4b5",
      "name": "Responses",
      "items": [
        {
          "kind": "request",
          "id": "2c5db4b7-0843-4d44-b9b0-0c56bc5a4373",
          "name": "Get UUID (extract)",
          "method": "GET",
          "url": "{{base_url}}/uuid",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.uuid",
              "op": "exists",
              "expected": ""
            }
          ],
          "extractions": [
            {
              "enabled": true,
              "variable": "last_uuid",
              "source": "json.uuid"
            }
          ],
          "examples": [
            {
              "id": "8c4f5097-f63b-4eb2-bf03-7a37fe443ae6",
              "name": "Random UUID",
              "status": 200,
              "headers": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "enabled": true
                }
              ],
              "body": "{ \"uuid\": \"0f8e6a7c-2b1d-4c3e-9f5a-8d7b6c5e4f3a\" }"
            }
          ]
        },
        {
          "kind": "request",
          "id": "8f241798-417f-4846-bb1b-5db64c02b3f5",
          "name": "JSON document",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "json.slideshow.author",
              "op": "exists",
              "expected": ""
            }
          ]
        },
        {
          "kind": "request",
          "id": "2c080f77-934e-4b16-8456-610ab3c66636",
          "name": "Expect 404",
          "method": "GET",
          "url": "{{base_url}}/status/404",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "assertions": [
            {
              "enabled": true,
              "target": "status",
              "op": "equals",
              "expected": "404"
            }
          ]
        },
        {
          "kind": "request",
          "id": "fcdba6bd-218a-498e-b2d0-d328ef2f6fe4",
          "name": "Scripted checks (JavaScript)",
          "method": "GET",
          "url": "{{base_url}}/json",
          "body": {
            "mode": "none"
          },
          "auth": {
            "type": "inherit"
          },
          "scripts": {
            "pre_request": "// Runs before sending: add a trace header.\npm.request.headers.upsert({ key: \"X-Trace-Id\", value: pm.variables.replaceIn(\"{{$guid}}\") });\n",
            "test": "pm.test(\"Status code is 200\", () => {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"Slideshow has slides\", () => {\n  const json = pm.response.json();\n  pm.expect(json.slideshow.slides).to.be.an(\"array\").that.is.not.empty;\n  pm.expect(json.slideshow.author).to.eql(\"PakPos\");\n});\n\npm.environment.set(\"slide_count\", pm.response.json().slideshow.slides.length);\nconsole.log(\"slides:\", pm.environment.get(\"slide_count\"));\n"
          },
          "description": "Postman-style pm.* scripts, run in a sandbox. Collections you import must be trusted before their scripts run."
        }
      ],
      "auth": {
        "type": "inherit"
      }
    }
  ],
  "auth": {
    "type": "none"
  }
}
