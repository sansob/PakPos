{
  "info": {
    "_postman_id": "pakpos-demo",
    "name": "PakPos Demo",
    "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Basics",
      "item": [
        {
          "name": "Get with query params",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/get?lang=id&app=pakpos",
              "query": [
                {
                  "key": "lang",
                  "value": "id"
                },
                {
                  "key": "app",
                  "value": "pakpos"
                }
              ]
            },
            "description": "Sends query parameters and checks they are echoed back."
          }
        },
        {
          "name": "Create user (JSON)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/post",
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Submit form",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/post",
              "query": []
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "budi"
                },
                {
                  "key": "remember",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/put",
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"city\": \"Bandung\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patch user",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/patch",
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"active\": true }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/delete",
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Bearer token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/bearer",
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Basic auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/basic-auth/pakpos/rahasia",
              "query": []
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "pakpos",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "rahasia",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Responses",
      "item": [
        {
          "name": "Get UUID (extract)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/uuid",
              "query": []
            }
          }
        },
        {
          "name": "JSON document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/json",
              "query": []
            }
          }
        },
        {
          "name": "Expect 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/status/404",
              "query": []
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "noauth"
  }
}
