{
  "info": {
    "_postman_id": "pakpos-demo",
    "name": "PakPos Demo",
    "description": "Sample requests against an httpbin-compatible API. Select the “Demo (httpbin)” environment and press Send.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Basics",
      "item": [
        {
          "name": "Get with query params",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/get?lang=id&app=pakpos",
              "query": [
                {
                  "key": "lang",
                  "value": "id"
                },
                {
                  "key": "app",
                  "value": "pakpos"
                }
              ]
            },
            "description": "Sends query parameters and checks they are echoed back."
          }
        },
        {
          "name": "Create user (JSON)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/post",
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"city\": \"Jakarta\",\n  \"request_id\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Submit form",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/post",
              "query": []
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "budi"
                },
                {
                  "key": "remember",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/put",
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"city\": \"Bandung\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Patch user",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{base_url}}/patch",
              "query": []
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"active\": true }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/delete",
              "query": []
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Bearer token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/bearer",
              "query": []
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Basic auth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/basic-auth/pakpos/rahasia",
              "query": []
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "pakpos",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "rahasia",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Profile (OAuth 2.0)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/oauth/me",
              "query": []
            },
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "string"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "{{base_url}}/oauth/token",
                  "type": "string"
                },
                {
                  "key": "authUrl",
                  "value": "{{base_url}}/oauth/authorize",
                  "type": "string"
                },
                {
                  "key": "clientId",
                  "value": "pakpos-demo",
                  "type": "string"
                },
                {
                  "key": "clientSecret",
                  "value": "demo-secret",
                  "type": "string"
                },
                {
                  "key": "scope",
                  "value": "read",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "",
                  "type": "string"
                },
                {
                  "key": "redirect_uri",
                  "value": "http://127.0.0.1:7777/callback",
                  "type": "string"
                },
                {
                  "key": "headerPrefix",
                  "value": "Bearer",
                  "type": "string"
                },
                {
                  "key": "challengeAlgorithm",
                  "value": "S256",
                  "type": "string"
                },
                {
                  "key": "client_authentication",
                  "value": "header",
                  "type": "string"
                },
                {
                  "key": "addTokenTo",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "The token is fetched automatically (client credentials). Switch the grant to Authorization code to try the browser login against the mock API."
          }
        }
      ]
    },
    {
      "name": "Responses",
      "item": [
        {
          "name": "Get UUID (extract)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/uuid",
              "query": []
            }
          }
        },
        {
          "name": "JSON document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/json",
              "query": []
            }
          }
        },
        {
          "name": "Expect 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/status/404",
              "query": []
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "noauth"
  }
}
